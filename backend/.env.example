# Optional backend settings; no Binance API key is needed for public market data.
# From the project root, copy to backend/.env (do not overwrite an existing file).
# Load it explicitly when starting the backend:
# uv run --project backend uvicorn backend.app.main:app --env-file backend/.env --port 8000
# The settings loader reads process environment; it does not auto-load this file.
# Regional access, rate limits and data-use terms apply; do not bypass restrictions.

# Optional override for Binance Spot REST base URL.
BINANCE_REST_BASE_URL=https://api.binance.com

# Optional override for Binance Spot WebSocket base URL.
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

# CSV list of symbols and intervals.
TRACKED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,MATICUSDT
TRACKED_INTERVALS=1m,5m,1h,4h,1d

# Runtime tuning.
BOOTSTRAP_CANDLES_LIMIT=600
PREDICTION_HISTORY_LIMIT=200
MODEL_MIN_CANDLES=120

# Training tuning.
TRAINING_CANDLES_LIMIT=1200
TRAINING_MIN_SAMPLES=250
TRAINING_EPOCHS=600
TRAINING_LEARNING_RATE=0.05
TRAINING_L2=0.002
