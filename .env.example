# Copy this file to .env.local in the project root, then fill in free keys below.
# Do not overwrite an existing .env.local. Restart Next.js after editing it.
# Never put a secret in NEXT_PUBLIC_* variables or commit your .env.local.
# Free-tier details checked 2026-10-21; quotas and usage rights still apply.

# LOCAL BACKEND — no paid service or API key needed for this connection.
# Start FastAPI separately; these URLs alone do not start it.
# Binance public market endpoints do not require a Binance account/trading key.
# Regional availability and upstream data-use terms apply.
# For npm run dev only. On Vercel (including vercel dev), the app uses the
# BACKEND_URL service binding instead. Never create/set BACKEND_URL yourself.
BACKEND_API_BASE_URL=http://localhost:8000
# Optional local persistent backend only. Leave unset in Vercel deployments.
# Internal binding URLs must never be exposed through NEXT_PUBLIC_* variables.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/market

# Optional local development cache recovery (not required on Vercel):
# NEXT_DISABLE_TURBOPACK_CACHE=1

# FREE KEY: NewsData account -> dashboard -> API key.
# Sign up: https://newsdata.io/register
# Plan: https://newsdata.io/blog/pricing-plan-in-newsdata-io/
# Free: 200 credits/day, up to 10 articles/credit, 12-hour delayed news.
# No full article text. Feed access depends on endpoint/plan entitlements.
# Used for the news page and optional specialist news evidence.
# Leave blank if you do not need upstream news.
NEWSDATA_API_KEY=

# FREE KEY: CoinGecko account -> Developers Dashboard -> Demo API key.
# Sign up: https://www.coingecko.com/en/developers/dashboard
# Plan: https://www.coingecko.com/en/api/pricing
# Free Demo: 10,000 calls/month, 100/minute, up to 1 year of daily history.
# Attribution required; intended for testing/exploration. Review public-use rights.
# Used by research/scenario APIs, NOT the Binance-backed Markets page.
# Demo history is insufficient for the existing 1/3/5-year projection gates.
# The current adapter accepts Demo keys, not paid Pro keys.
COINGECKO_DEMO_API_KEY=

# OPTIONAL LOCAL SECRET — generated by you, not purchased from a provider.
# Generate with: openssl rand -hex 32
# Used as Authorization: Bearer <token> by server-side research API callers.
# Leave blank to keep protected research endpoints inaccessible.
ANALYSIS_ACCESS_TOKEN=

# FREE SETUP: keep specialist analysis and scenario releases disabled.
# Filling free keys does not enable Discover recommendations or projections.
SPECIALIST_ANALYSIS_ENABLED=false
SCENARIO_RELEASE_ENABLED=false

# OPTIONAL PAID OPENAI INTEGRATION — leave key blank for the free-only setup.
# The current implementation calls OpenAI; API usage is billed by tokens.
# No guaranteed free inference allowance. ChatGPT access is not an API credit.
# Pricing: https://developers.openai.com/api/docs/pricing
# Do not enable until provider permissions and evaluations are reviewed.
OPENAI_API_KEY=
# Suggested starting model for evaluation; model choice alone does not prove quality.
CRYPTO_ANALYSIS_MODEL=gpt-5.4

# Opt-in experimental Discover: AI selects among BTC/ETH/SOL from live evidence.
# Requires SPECIALIST_ANALYSIS_ENABLED, OpenAI access and current market data.
# Uses constrained AI percentages rather than a fixed strategy; results are labelled
# experimental and have not passed human specialist evaluation. API calls cost money.
# Leave false to retain the reviewed fixed-strategy path below.
DISCOVER_AI_RECOMMENDATIONS_ENABLED=false

# ADVANCED CONFIGURATION — not API keys; leave blank until reviewed.
# Optional legacy external allocation endpoint; not a bundled free service.
ALLOCATION_SERVICE_URL=
# Server-owned allocation strategy; no default/recommended basket is supplied.
ALLOCATION_STRATEGY_JSON=
# Specialist-vs-generic report must match selected model and skill hash.
SPECIALIST_EVALUATION_REPORT_PATH=
# Scenario review must match the actual dataset fingerprint.
SCENARIO_REVIEW_REPORT_PATH=

# US/SINGAPORE STOCKS — no additional stock API key is needed by this adapter.
# Uses free public Yahoo Finance and SGX feeds; quotes may be delayed.
# Public endpoints can change or be rate-limited and are not an official API SLA.
# Check provider terms before public/commercial use. OpenAI analysis is still paid.
