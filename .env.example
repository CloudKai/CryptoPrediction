# Optional: set this to use your Python backend WebSocket stream directly.
# Example: ws://localhost:8000/ws/market
NEXT_PUBLIC_WS_URL=

# Optional: if set, Next.js API routes proxy REST calls to your backend.
# Example: http://localhost:8000
BACKEND_API_BASE_URL=

# Server-only NewsData key used by /api/crypto-news route.
# Keep this out of NEXT_PUBLIC_* variables.
NEWSDATA_API_KEY=

# Optional legacy external allocation endpoint (full HTTPS POST URL).
ALLOCATION_SERVICE_URL=

# Experimental in-process specialist integration, disabled until evaluated.
SPECIALIST_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
# Choose a Responses API model supporting structured output and token preflight.
CRYPTO_ANALYSIS_MODEL=
COINGECKO_DEMO_API_KEY=

# Server-side client credential for portfolio research/evaluation APIs.
ANALYSIS_ACCESS_TOKEN=
# Keep false until real-data evaluation and release review are accepted.
SCENARIO_RELEASE_ENABLED=false

# No default allocation strategy. Supply reviewed server-owned configuration.
ALLOCATION_STRATEGY_JSON=
# Reviewed live specialist-vs-generic results for the selected model and skill hash.
SPECIALIST_EVALUATION_REPORT_PATH=
# Review approval must match the actual scenario dataset fingerprint.
SCENARIO_REVIEW_REPORT_PATH=
